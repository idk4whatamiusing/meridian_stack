DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
# kv (Cloudflare) or redis (AWS). redis sessions/cache is the default.
CACHE_BACKEND=redis
BACKEND_SECRET=change-me
PORT=8000

# only for CACHE_BACKEND=kv:
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE=
# CF_API_TOKEN=
# Google OAuth (optional in dev; required in prod)
# Console: https://console.cloud.google.com/apis/credentials , redirect URI = http://localhost:8000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# APP_URL=/  # where to send the browser after successful login, e.g. http://localhost:3000/dashboard
