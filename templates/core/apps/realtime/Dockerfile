# gleam publishes versioned images on GHCR only (no :latest on Docker Hub)
FROM ghcr.io/gleam-lang/gleam:v1.18.1-erlang-alpine AS build
WORKDIR /app
COPY gleam.toml manifest.toml ./
COPY src src
RUN gleam export erlang-shipment

FROM erlang:alpine
WORKDIR /app
COPY --from=build /app/build/erlang-shipment ./
EXPOSE 8001
# entrypoint.sh is generated by the export; invoke via sh so it does not need
# to be the literal first line of a script
CMD ["/bin/sh", "./entrypoint.sh", "run"]
