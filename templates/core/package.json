{
  "name": "{{name}}",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ui": "bun --cwd apps/ui dev",
    "dev:api": "cargo run --manifest-path apps/api/Cargo.toml",
    "dev:realtime": "cd apps/realtime && gleam run",
    "build:ui": "bun --cwd apps/ui build"
  }
}
